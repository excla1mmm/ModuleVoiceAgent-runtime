# --- LLM (OpenAI-compatible chat completions with streaming and tools) ---
# Default: Cloud.ru Foundation Models, openai/gpt-oss-120b, {"reasoning_effort":"low"}.
LLM_URL=https://foundation-models.api.cloud.ru/v1/chat/completions
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# LLM_API_KEY_FILE=/run/secrets/llm_key
LLM_EXTRA_JSON={"reasoning_effort":"low"}
LLM_TIMEOUT=30
LLM_TEMPERATURE=0.2

# Optional secondary provider: asked when the primary gives no first token within LLM_HEDGE_MS or fails.
# LLM2_URL=
# LLM2_MODEL=
# LLM2_API_KEY=
# LLM2_EXTRA_JSON={}
LLM_HEDGE_MS=600
# Failover for every call after this many slow (no first token within LLM_HEDGE_MS) or failed turns of the
# provider asked first within the window (0: off). While on the secondary, the primary is probed every
# LLM_RECOVERY_PROBE_S seconds with LLM_RECOVERY_PROBES requests; all answered in time bring it back.
LLM_FAILOVER_AFTER=3
LLM_FAILOVER_WINDOW_S=300
LLM_RECOVERY_PROBE_S=28800
LLM_RECOVERY_PROBES=3

# --- TLS (Asterisk connects with wss://, the PBX module with https://) ---
VA_TLS_CERT=/tls/fullchain.pem
VA_TLS_KEY=/tls/privkey.pem
# Host directory with the certificate files (mounted read-only at /tls).
VA_TLS_DIR=./tls
# Published port (Asterisk and the PBX connect to it).
VA_PUBLIC_PORT=443
VA_PUBLIC_BIND=0.0.0.0
# For TLS termination on the same host, bind 127.0.0.1 and set VA_TRUSTED_PROXY=true.
# VA_TRUSTED_PROXY=true

# --- Tenants: PBX ids and SHA-256 of their tokens ---
VA_TENANTS_FILE=/config/tenants.json

# --- Operator access: /metrics and the full /health (all PBXs) need this Bearer token ---
# Required for blue-green updates (compose.bluegreen.yaml): the instances authenticate each other with it.
VA_ADMIN_TOKEN=
# VA_ADMIN_TOKEN_FILE=/run/secrets/admin_token

# --- Capacity and turn-taking ---
# ~2 concurrent calls per vCPU keep p95 answer latency near 1.2 s (STT is the bottleneck).
# auto = 2 calls per CPU available to the container.
VA_MAX_CALLS=auto
# Per-PBX limits (tenants.json max_calls / max_agents override them). 0 = only the global VA_MAX_CALLS.
VA_MAX_CALLS_PER_TENANT=0
VA_MAX_AGENTS_PER_TENANT=20
# Unclaimed results kept per PBX; the oldest are evicted above it.
VA_MAX_RESULTS_PER_TENANT=1000
# WebSocket ping interval in seconds (half-open media links free their slot); 0 = off.
VA_WS_HEARTBEAT=20
# On SIGTERM: refuse new calls, give active calls this long, then hang them up (fallback) and exit.
# Keep compose stop_grace_period above it (+ ~15 s).
VA_DRAIN_SECONDS=30
# Synthesized phrase cache (greetings, service phrases) in MB.
VA_PHRASE_CACHE_MB=256
VA_ASR_THREADS=1
VA_SPECULATE_MS=120
VA_TURN_END_MS=600
VA_QUESTION_END_MS=300
VA_BARGE_IN_FRAMES=4
# Voices to load (empty = all): ru_RU-dmitri-medium, ru_RU-denis-medium, silero-ekaterina, silero-oksana,
# silero-zinaida, silero-roman, silero-eduard. Without Silero voices torch is not loaded.
VA_VOICES=
VA_DEFAULT_VOICE=ru_RU-dmitri-medium
VA_RESULT_TTL=900
VA_MAX_CALL_SECONDS=1800

# Usage (billing) counters; the compose file mounts the data volume at /data. Empty = RAM only.
VA_USAGE_DB=/data/usage.sqlite3
VA_USAGE_FLUSH_SECONDS=30
# Token usage in the LLM stream (stream_options.include_usage); false for providers that reject it.
# LLM_STREAM_USAGE=true

# --- Speech recognition ---
# Incremental recognition of long turns: pieces cut at internal pauses are recognized while the caller talks.
VA_STT_CHUNKS=true
VA_STT_CHUNK_PAUSE_MS=160
VA_STT_CHUNK_MIN_MS=1000
# Bias recognition towards the agent's terms (bundle hotwords, names, departments, ...); 0 boost = no decoder bias.
VA_HOTWORDS=true
# Echo cancellation for callers on a speakerphone without their own (livekit WebRTC AEC3)
VA_AEC=true
# Refuse topics foreign to the company (a short side LLM request per caller phrase, in parallel)
VA_TOPIC_FILTER=true
# The date and time the agent knows
VA_TIMEZONE=Europe/Moscow
VA_HOTWORD_BOOST=0.45

# --- Logs: technical fields only; transcripts stay out of the logs unless enabled here ---
VA_LOG_LEVEL=INFO
VA_LOG_TRANSCRIPTS=false
